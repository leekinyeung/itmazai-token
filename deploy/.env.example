# 生产环境变量模板。复制为 <DEPLOY_PATH>/.env 后填写真实值，绝不要提交真实密码。
#
#   cp deploy/.env.example /opt/itmazai/.env
#   chmod 600 /opt/itmazai/.env
#   openssl rand -hex 32   # 用于生成 SESSION_SECRET / POSTGRES_PASSWORD / REDIS_PASSWORD

# ---------- 基础设施（docker-compose.infra.yml 读取） ----------
POSTGRES_USER=itmazai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=new-api
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_MAXMEMORY=256mb

# ---------- 应用（docker-compose.app.yml 读取，容器内可见） ----------
# 注意主机名使用 infra 栈的容器名，两者通过 APP_NETWORK 网络互通。
# 接管已有栈时：APP_NETWORK 指向旧网络，DSN/Redis 用旧容器名（如 postgres / redis）。
SQL_DSN=postgresql://itmazai:CHANGE_ME_STRONG_PASSWORD@itmazai-postgres:5432/new-api
REDIS_CONN_STRING=redis://:CHANGE_ME_STRONG_PASSWORD@itmazai-redis:6379

# 多节点或重启后保持登录态必须固定该值。
SESSION_SECRET=CHANGE_ME_RANDOM_32_BYTES_HEX
# 生产走 HTTPS 时开启，并填写精确的 HTTPS Origin（不是 relay CORS 白名单）。
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://your-domain.example.com

# 反向代理在宿主机上，容器看到的来源是 docker 网桥地址。
TRUSTED_PROXIES=172.16.0.0/12

# ---------- 运行参数（可选项，按需打开） ----------
TZ=Asia/Shanghai
NODE_NAME=itmazai-prod-1
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
# APP_PORT=3000
# APP_MEMORY_LIMIT=2g
# STREAMING_TIMEOUT=300
# DEFAULT_LANGUAGE=zh-CN

# ---------- 部署脚本读取（可选覆盖） ----------
# HEALTH_TIMEOUT=180
# BACKUP_KEEP=7
# 接管已有栈：应用加入旧栈网络、备份指向旧 PG 容器（全新栈无需设置）。
# APP_NETWORK=new-api_new-api-network
# PG_CONTAINER=postgres
