{
  "name": "taodock",
  "displayName": "Taodock — AI Models",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "taodock",
  "author": "Taodock",
  "license": "AGPL-3.0-only",
  "icon": "assets/icon.png",
  "homepage": "https://taodock.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekinyeung/itmazai-token.git",
    "directory": "extensions/taodock-vscode"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": ["AI", "Chat"],
  "keywords": ["taodock", "byok", "gpt", "claude", "language model"],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "taodock",
        "displayName": "Taodock",
        "managementCommand": "taodock.manage"
      }
    ],
    "commands": [
      {
        "command": "taodock.manage",
        "title": "%command.manage%",
        "category": "Taodock"
      },
      {
        "command": "taodock.refreshModels",
        "title": "%command.refresh%",
        "category": "Taodock"
      },
      {
        "command": "taodock.removeKey",
        "title": "%command.remove%",
        "category": "Taodock"
      },
      {
        "command": "taodock.openConsole",
        "title": "%command.console%",
        "category": "Taodock"
      },
      {
        "command": "taodock.openDocs",
        "title": "%command.docs%",
        "category": "Taodock"
      }
    ]
  },
  "scripts": {
    "localize": "node scripts/localize.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "vscode:prepublish": "bun run typecheck && bun run build",
    "package": "vsce package --no-dependencies",
    "publish:openvsx": "node scripts/publish-openvsx.mjs"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "22",
    "@types/vscode": "1.104.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "ovsx": "1.3.0",
    "typescript": "7.0.2"
  }
}
